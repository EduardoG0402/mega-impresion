{
  "name": "impresion",
  "version": "1.2.2",
  "description": "Módulo de Impresión - MEGA",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.mega.impresion",
    "files": [
      "src/**/*",
      "db.js",
      ".env",
      "node_modules/**/*"
    ],
     "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EduardoG0402",
        "repo": "mega-impresion"
      }
    ]
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "electron-updater": "^6.3.9",
    "getmac": "^6.6.0",
    "mssql": "^12.7.10"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
